---
const { title } = Astro.props;
const currentPath = Astro.url.pathname;
const isActive = (href) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,600;6..72,700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --ink: #211b1a;
        --paper: #f4efe5;
        --paper-light: #fffdf8;
        --burgundy: #832b42;
        --burgundy-dark: #5c1d2e;
        --brass: #bd9145;
        --sage: #647469;
        --muted: #746b63;
        --border: #ddd1c1;
        --shadow: 0 18px 50px rgba(57, 38, 30, 0.08);
      }

      *, *::before, *::after { box-sizing: border-box; }

      html {
        scroll-behavior: smooth;
        background: var(--paper);
      }

      body {
        margin: 0;
        background:
          radial-gradient(circle at 12% 4%, rgba(189, 145, 69, 0.11), transparent 24rem),
          linear-gradient(180deg, #f8f4ec 0%, var(--paper) 100%);
        color: var(--ink);
        font-family: 'DM Sans', sans-serif;
        font-size: 1.05rem;
        line-height: 1.7;
        min-height: 100vh;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(255, 253, 248, 0.92);
        color: var(--ink);
        padding: 0 1.5rem;
        border-bottom: 1px solid rgba(131, 43, 66, 0.14);
        box-shadow: 0 8px 28px rgba(57, 38, 30, 0.05);
        backdrop-filter: blur(14px);
      }

      .header-inner {
        max-width: 72rem;
        min-height: 5rem;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
      }

      header a.site-name {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        flex: 0 0 auto;
        font-family: 'Newsreader', Georgia, serif;
        font-size: 1.65rem;
        font-weight: 700;
        color: var(--burgundy-dark);
        text-decoration: none;
        letter-spacing: -0.025em;
      }

      .site-mark {
        width: 0.7rem;
        height: 0.7rem;
        background: var(--brass);
        border-radius: 50% 50% 50% 0;
        rotate: -45deg;
        box-shadow: 0 0 0 4px rgba(189, 145, 69, 0.13);
      }

      nav {
        display: flex;
        align-items: stretch;
        gap: 0.25rem;
      }

      nav a {
        position: relative;
        display: flex;
        align-items: center;
        min-height: 5rem;
        padding: 0 0.7rem;
        color: var(--muted);
        text-decoration: none;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.075em;
        text-transform: uppercase;
        transition: color 0.2s ease;
      }

      nav a::after {
        content: '';
        position: absolute;
        right: 0.7rem;
        bottom: 0.85rem;
        left: 0.7rem;
        height: 2px;
        background: var(--burgundy);
        transform: scaleX(0);
        transform-origin: center;
        transition: transform 0.2s ease;
      }

      nav a:hover,
      nav a[aria-current="page"] {
        color: var(--burgundy);
      }

      nav a:hover::after,
      nav a[aria-current="page"]::after {
        transform: scaleX(1);
      }

      .nav-toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 5px;
        width: 2.75rem;
        height: 2.75rem;
        padding: 0;
        flex: 0 0 auto;
        background: transparent;
        border: 1px solid rgba(131, 43, 66, 0.2);
        border-radius: 0.5rem;
        cursor: pointer;
      }

      .nav-toggle span {
        display: block;
        width: 1.35rem;
        height: 2px;
        background: var(--ink);
        border-radius: 1px;
        transition: transform 0.2s ease, opacity 0.2s ease;
      }

      .nav-toggle[aria-expanded="true"] span:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
      }

      .nav-toggle[aria-expanded="true"] span:nth-child(2) {
        opacity: 0;
      }

      .nav-toggle[aria-expanded="true"] span:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
      }

      a:focus-visible {
        outline: 3px solid rgba(131, 43, 66, 0.28);
        outline-offset: 4px;
        border-radius: 2px;
      }

      main {
        width: min(100% - 2rem, 64rem);
        margin: 0 auto;
        padding: clamp(3rem, 7vw, 6.5rem) clamp(0rem, 2vw, 1.5rem) 7rem;
      }

      main::before {
        content: 'NYC BALBOA · EST. IN COMMUNITY';
        display: block;
        margin-bottom: 1.25rem;
        color: var(--sage);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.18em;
      }

      h1 {
        max-width: 14ch;
        margin: 0 0 2rem;
        color: var(--ink);
        font-family: 'Newsreader', Georgia, serif;
        font-size: clamp(3rem, 8vw, 5.4rem);
        font-weight: 600;
        letter-spacing: -0.045em;
        line-height: 0.98;
      }

      h2 {
        position: relative;
        margin: 3.5rem 0 1rem;
        padding-top: 1.2rem;
        color: var(--burgundy-dark);
        font-family: 'Newsreader', Georgia, serif;
        font-size: clamp(1.7rem, 4vw, 2.35rem);
        font-weight: 600;
        letter-spacing: -0.025em;
        line-height: 1.15;
        border-top: 1px solid var(--border);
      }

      h2::before {
        content: '';
        position: absolute;
        top: -1px;
        left: 0;
        width: 4rem;
        height: 3px;
        background: var(--brass);
      }

      a {
        color: var(--burgundy);
        text-decoration: underline;
        text-decoration-color: rgba(131, 43, 66, 0.35);
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
        transition: color 0.15s ease, text-decoration-color 0.15s ease;
      }

      a:hover {
        color: var(--burgundy-dark);
        text-decoration-color: currentColor;
      }

      p {
        max-width: 46rem;
        margin: 0.7rem 0 0;
      }

      main > p:first-of-type,
      main > :global(p:first-of-type) {
        color: #4d4540;
        font-size: clamp(1.15rem, 2.5vw, 1.35rem);
        line-height: 1.65;
      }

      main ul,
      main ol {
        max-width: 48rem;
        margin: 1rem 0 0;
        padding-left: 1.35rem;
      }

      main li {
        padding: 0.35rem 0 0.35rem 0.35rem;
      }

      main li::marker {
        color: var(--brass);
        font-weight: 700;
      }

      main hr {
        margin: 3rem 0;
        border: 0;
        border-top: 1px solid var(--border);
      }

      footer {
        background: var(--ink);
        color: #d9cfc1;
        padding: 3.25rem 1.5rem;
        text-align: center;
        font-size: 0.85rem;
        letter-spacing: 0.035em;
      }

      .social-links {
        display: flex;
        justify-content: center;
        gap: 1.25rem;
        margin-bottom: 0.75rem;
      }

      .social-links a {
        display: grid;
        width: 2.65rem;
        height: 2.65rem;
        place-items: center;
        color: #d9cfc1;
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 50%;
        transition: color 0.15s, border-color 0.15s, transform 0.15s;
      }

      .social-links a:hover {
        color: #fff8ec;
        border-color: var(--brass);
        transform: translateY(-2px);
      }

      .social-links svg {
        width: 19px;
        height: 19px;
        fill: currentColor;
      }

      @media (max-width: 760px) {
        header {
          padding: 0.8rem 1rem;
        }

        .header-inner {
          min-height: auto;
        }

        header a.site-name {
          font-size: 1.45rem;
        }

        .nav-toggle {
          display: flex;
        }

        nav {
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          max-height: 0;
          overflow: hidden;
          visibility: hidden;
          background: var(--paper-light);
          border-bottom: 1px solid var(--border);
          box-shadow: var(--shadow);
          transition: max-height 0.25s ease;
        }

        nav[data-open="true"] {
          max-height: 24rem;
          visibility: visible;
        }

        nav a {
          min-height: auto;
          padding: 1rem 1.5rem;
          font-size: 0.85rem;
          justify-content: flex-start;
        }

        nav a::after {
          display: none;
        }

        nav a[aria-current="page"] {
          background: rgba(131, 43, 66, 0.08);
        }

        main {
          width: min(100% - 2rem, 64rem);
          padding-top: 3.5rem;
          padding-bottom: 5rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { transition: none !important; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="header-inner">
        <a href="/" class="site-name"><span class="site-mark" aria-hidden="true"></span>NYC Balboa</a>
        <button id="nav-toggle" class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <nav id="primary-nav" aria-label="Primary navigation" data-open="false">
          <a href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a>
          <a href="/begin" aria-current={isActive('/begin') ? 'page' : undefined}>Begin</a>
          <a href="/socials" aria-current={isActive('/socials') ? 'page' : undefined}>Socials</a>
          <a href="/learn" aria-current={isActive('/learn') ? 'page' : undefined}>Learn</a>
          <a href="/calendar" aria-current={isActive('/calendar') ? 'page' : undefined}>Calendar</a>
          <a href="/resources" aria-current={isActive('/resources') ? 'page' : undefined}>Resources</a>
        </nav>
      </div>
    </header>
    <script>
      const navToggle = document.getElementById('nav-toggle');
      const primaryNav = document.getElementById('primary-nav');

      navToggle.addEventListener('click', () => {
        const isOpen = primaryNav.getAttribute('data-open') === 'true';
        primaryNav.setAttribute('data-open', String(!isOpen));
        navToggle.setAttribute('aria-expanded', String(!isOpen));
      });

      primaryNav.addEventListener('click', (event) => {
        if (event.target instanceof HTMLElement && event.target.tagName === 'A') {
          primaryNav.setAttribute('data-open', 'false');
          navToggle.setAttribute('aria-expanded', 'false');
        }
      });
    </script>
    <main>
      <slot />
    </main>
    <footer>
      <div class="social-links">
        <a href="https://www.instagram.com/nycbalboa/" aria-label="Instagram" target="_blank" rel="noopener">
