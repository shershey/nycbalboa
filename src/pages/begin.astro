---
import Layout from '../layouts/Layout.astro';
import { Content } from '../content/begin.md';
---
<Layout title="Begin Your Journey — NYC Balboa">
  <div class="begin-page">
    <Content />
  </div>
</Layout>

<style>
  .begin-page {
    --card-surface: rgba(255, 253, 248, 0.78);
  }

  .begin-page :global(.begin-intro) {
    max-width: 58rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .begin-page :global(.begin-intro h1) {
    max-width: none;
    margin-bottom: 1.5rem;
    font-size: clamp(3rem, 7vw, 5.4rem);
    white-space: nowrap;
  }

  .begin-page :global(.begin-lede) {
    max-width: 52rem;
    margin: 0;
    color: #4d4540;
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.7;
  }

  .begin-page :global(.path-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .begin-page :global(.path-card) {
    position: relative;
    display: flex;
    min-height: 30rem;
    flex-direction: column;
    padding: clamp(1.6rem, 4vw, 2.4rem);
    overflow: hidden;
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-top: 4px solid var(--burgundy);
    border-radius: 0.25rem;
    box-shadow: 0 16px 40px rgba(57, 38, 30, 0.055);
  }

  .begin-page :global(.path-card:nth-child(even)) {
    border-top-color: var(--brass);
  }

  .begin-page :global(.path-number) {
    position: absolute;
    top: 0.5rem;
    right: 1rem;
    color: rgba(189, 145, 69, 0.15);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(4.75rem, 9vw, 7rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
    pointer-events: none;
  }

  .begin-page :global(.path-label) {
    position: relative;
    margin: 0 0 1.4rem;
    color: var(--sage);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .begin-page :global(.path-card h2) {
    position: relative;
    max-width: 12ch;
    margin: 0 0 1.1rem;
    padding: 0;
    color: var(--ink);
    font-size: clamp(1.7rem, 3.2vw, 2.25rem);
    border: 0;
  }

  .begin-page :global(.path-card h2::before) {
    display: none;
  }

  .begin-page :global(.path-card > p:not(.path-label):not(.alternate-note)) {
    position: relative;
    margin: 0;
    color: #514943;
    line-height: 1.65;
  }

  .begin-page :global(.path-benefits) {
    margin: 1rem 0 0;
    padding-left: 1.15rem;
    color: #514943;
  }

  .begin-page :global(.path-benefits li) {
    padding: 0.12rem 0 0.12rem 0.25rem;
  }

  .begin-page :global(.practice-times) {
    margin: 1.15rem 0 0;
    border-top: 1px solid var(--border);
  }

  .begin-page :global(.practice-times div) {
    display: grid;
    grid-template-columns: 6.4rem 1fr;
    gap: 0.8rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--border);
  }

  .begin-page :global(.practice-times dt) {
    color: var(--burgundy-dark);
    font-weight: 700;
  }

  .begin-page :global(.practice-times dd) {
    margin: 0;
    color: #625951;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .begin-page :global(.alternate-note) {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .begin-page :global(.path-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .begin-page :global(.path-link) {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--burgundy);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.055em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .begin-page :global(.path-actions .path-link) {
    margin-top: 0;
    padding-top: 0;
  }

  .begin-page :global(.path-link-secondary) {
    color: var(--sage);
  }

  .begin-page :global(.path-link span),
  .begin-page :global(.next-step a span) {
    display: inline-block;
    margin-left: 0.25rem;
    transition: transform 0.15s ease;
  }

  .begin-page :global(.path-link:hover span),
  .begin-page :global(.next-step a:hover span) {
    transform: translateX(0.25rem);
  }

  .begin-page :global(.next-step) {
    display: grid;
    grid-template-columns: 8rem 1fr auto;
    align-items: center;
    gap: 2rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    padding: clamp(1.7rem, 4vw, 2.6rem);
    background:
      linear-gradient(120deg, rgba(92, 29, 46, 0.98), rgba(131, 43, 66, 0.94));
    color: #fff8ec;
    border-radius: 0.25rem;
    box-shadow: 0 18px 45px rgba(92, 29, 46, 0.16);
  }

  .begin-page :global(.next-step-kicker) {
    margin: 0;
    color: #e0bd7c;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .begin-page :global(.next-step h2) {
    margin: 0 0 0.35rem;
    padding: 0;
    color: #fff8ec;
    font-size: clamp(1.55rem, 3vw, 2rem);
    border: 0;
  }

  .begin-page :global(.next-step h2::before) {
    display: none;
  }

  .begin-page :global(.next-step p:not(.next-step-kicker)) {
    max-width: 35rem;
    margin: 0;
    color: rgba(255, 248, 236, 0.8);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .begin-page :global(.next-step > a) {
    white-space: nowrap;
    color: #fff8ec;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration-color: rgba(255, 248, 236, 0.45);
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .begin-page :global(.path-grid) {
      grid-template-columns: 1fr;
    }

    .begin-page :global(.path-card) {
      min-height: 0;
    }

    .begin-page :global(.next-step) {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .begin-page :global(.next-step > a) {
      margin-top: 0.5rem;
      justify-self: start;
    }
  }

  @media (max-width: 420px) {
    .begin-page :global(.begin-intro h1) {
      font-size: clamp(2.35rem, 12vw, 3rem);
      white-space: normal;
    }

    .begin-page :global(.practice-times div) {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
