---
import Layout from '../layouts/Layout.astro';
import { Content } from '../content/events.md';
const BASE_URL = 'https://calendar.google.com/calendar/embed?src=cca341fd504d87e8bdc5d22fa803d7237b5d8ad34696729ca076f27f7c36881d%40group.calendar.google.com&ctz=America%2FNew_York';
---
<Layout title="Events — NYC Balboa">
  <h1>Events</h1>
  <div class="intro">
    <Content />
  </div>
  <div class="calendar-wrap">
    <iframe
      id="cal"
      src={`${BASE_URL}&mode=MONTH`}
      style="border: 0"
      width="100%"
      height="600"
      frameborder="0"
      scrolling="no"
    ></iframe>
  </div>
</Layout>

<script define:vars={{ BASE_URL }}>
  const iframe = document.getElementById('cal');
  function updateMode() {
    const mode = window.innerWidth < 640 ? 'AGENDA' : 'MONTH';
    const next = `${BASE_URL}&mode=${mode}`;
    if (iframe.src !== next) iframe.src = next;
  }

  updateMode();
  window.addEventListener('resize', updateMode);
</script>

<style>
  .intro {
    max-width: 46rem;
    margin-bottom: 2.25rem;
    color: #4d4540;
    font-size: 1.1rem;
  }
</style>

<style is:global>
  .calendar-wrap {
    width: 100%;
    overflow: hidden;
    padding: 0.45rem;
    background: #fffdf8;
    border: 1px solid #ddd1c1;
    border-top: 4px solid #bd9145;
    border-radius: 0.75rem;
    box-shadow: 0 20px 60px rgba(57, 38, 30, 0.1);
  }

  .calendar-wrap iframe {
    display: block;
    border-radius: 0.35rem;
  }
</style>
