---
import Layout from '../layouts/Layout.astro';
import { Content } from '../content/learn.md';
---
<Layout title="Learn — NYC Balboa">
  <Content />
</Layout>

<style is:global>
  .instructor-card {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
    overflow: hidden;
    margin: 1rem 0 1.25rem;
    background: var(--paper-light);
    border: 1px solid var(--border);
    border-top: 3px solid var(--brass);
    border-radius: 0.9rem;
    box-shadow: 0 10px 28px rgba(57, 38, 30, 0.07);
  }

  .instructor-card__portrait {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 24rem;
    object-fit: cover;
    object-position: center 28%;
  }

  .instructor-card__details {
    padding: clamp(1rem, 2.6vw, 1.6rem);
    background: linear-gradient(135deg, rgba(189, 145, 69, 0.08), transparent 58%);
    font-size: 0.96rem;
    line-height: 1.5;
  }

  .instructor-card__details h3 {
    margin: 0 0 0.75rem;
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(1.65rem, 3.5vw, 2.1rem);
    line-height: 1.15;
  }

  .instructor-card__details h3 a {
    color: var(--burgundy-dark);
    text-decoration-color: var(--brass);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .instructor-card__details p {
    margin: 0 0 0.7rem;
  }

  .instructor-card__details p:last-child {
    margin-bottom: 0;
  }

  .instructor-card__details strong {
    color: var(--burgundy-dark);
  }

  .instructor-card__contact a {
    overflow-wrap: anywhere;
  }

  .instructor-card__contact-note {
    display: inline-block;
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.92em;
    font-style: italic;
  }

  @media (max-width: 760px) {
    .instructor-card {
      grid-template-columns: 1fr;
    }

    .instructor-card__portrait {
      height: auto;
      min-height: 0;
      object-fit: contain;
      object-position: center 30%;
    }
  }
</style>
